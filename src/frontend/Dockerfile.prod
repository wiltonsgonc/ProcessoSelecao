# ==============================================
# Frontend - Angular 19
# Dockerfile.prod — build estatico + nginx
# Imagem final minima (~25MB)
# ==============================================

# ----------------------------------------------
# Stage 1: build da aplicacao Angular
# ----------------------------------------------
FROM node:24-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm ci || npm install

COPY . .
RUN npm run build -- --configuration production

# ----------------------------------------------
# Stage 2: nginx (servidor estatico)
# ----------------------------------------------
FROM nginx:alpine AS final
COPY --from=build /app/dist/processo-selecao-frontend/browser /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
