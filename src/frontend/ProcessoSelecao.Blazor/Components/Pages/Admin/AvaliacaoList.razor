@page "/admin/avaliacoes"
@using ProcessoSelecao.Blazor.Models
@using ProcessoSelecao.Blazor.Services
@layout Layouts.AdminLayout
@inject BaremaService BaremaService
@inject ProcessoSelecaoService ProcessoService
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Avaliações</PageTitle>

<h1 class="text-2xl font-bold mb-5">Avaliações</h1>

<!-- Filtro por processo -->
<div class="bg-white border border-gray-200 rounded-lg p-5 mb-5">
    <label class="block text-sm font-medium mb-2">Processo Seletivo</label>
    <select class="w-full px-3 py-2 border border-gray-300 rounded" @bind="processoSelecionadoId" @bind:after="OnProcessoChanged">
        <option value="">-- Todos os processos --</option>
        @foreach (var p in processos)
        {
            <option value="@p.Id">@p.Nome (@p.TipoProcesso)</option>
        }
    </select>
</div>

@if (carregando)
{
    <div class="text-center py-10">
        <span class="material-icons text-5xl text-gray-400 animate-spin">refresh</span>
        <p class="text-gray-500 mt-2">Carregando avaliações...</p>
    </div>
}
else
{
    <!-- Resumo geral -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-5">
        <div class="bg-white border border-gray-200 rounded-lg p-4 text-center">
            <p class="text-2xl font-bold text-gray-800">@progresso.Count</p>
            <p class="text-sm text-gray-500">Total Candidatos</p>
        </div>
        <div class="bg-green-50 border border-green-200 rounded-lg p-4 text-center">
            <p class="text-2xl font-bold text-green-600">@progresso.Count(p => p.AvaliadoresConcluidos >= p.AvaliadoresNecessarios)</p>
            <p class="text-sm text-gray-500">Avaliação Completa</p>
        </div>
        <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 text-center">
            <p class="text-2xl font-bold text-yellow-600">@progresso.Count(p => p.AvaliadoresAtribuidos > 0 && p.AvaliadoresConcluidos < p.AvaliadoresNecessarios)</p>
            <p class="text-sm text-gray-500">Em Andamento</p>
        </div>
        <div class="bg-red-50 border border-red-200 rounded-lg p-4 text-center">
            <p class="text-2xl font-bold text-red-600">@progresso.Count(p => p.AvaliadoresAtribuidos == 0)</p>
            <p class="text-sm text-gray-500">Sem Avaliador</p>
        </div>
    </div>

    @if (!progresso.Any())
    {
        <div class="text-center py-10 bg-white border border-gray-200 rounded-lg">
            <span class="material-icons text-5xl text-gray-400">assignment</span>
            <p class="text-gray-500 mt-2">Nenhuma avaliação encontrada.</p>
        </div>
    }
    else
    {
        <div class="space-y-3">
            @foreach (var p in progresso)
            {
                var statusClass = p.AvaliadoresConcluidos >= p.AvaliadoresNecessarios ? "border-green-400 bg-green-50"
                    : p.AvaliadoresAtribuidos > 0 ? "border-yellow-400 bg-yellow-50"
                    : "border-red-400 bg-red-50";

                <div class="bg-white border-l-4 @statusClass rounded-lg p-4">
                    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
                        <div class="flex-1">
                            <div class="flex items-center gap-2 mb-1">
                                <h3 class="font-semibold text-gray-800">@p.CandidatoNome</h3>
                                <span class="text-xs text-gray-500">#@p.NumeroInscricao</span>
                            </div>
                            <div class="flex items-center gap-4 text-sm">
                                <span class="text-gray-600">
                                    Avaliadores: <strong>@p.AvaliadoresAtribuidos</strong>/@p.AvaliadoresNecessarios
                                </span>
                                <span class="text-gray-600">
                                    Concluídos: <strong>@p.AvaliadoresConcluidos</strong>/@p.AvaliadoresNecessarios
                                </span>
                            </div>
                        </div>

                        <div class="flex items-center gap-2">
                            @if (p.AvaliadoresConcluidos >= p.AvaliadoresNecessarios)
                            {
                                <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-sm font-semibold bg-green-100 text-green-800">
                                    <span class="material-icons text-sm">check_circle</span>
                                    Nota: @p.NotaFinal.ToString("F2")
                                </span>
                            }
                            else if (p.AvaliadoresAtribuidos > 0)
                            {
                                <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-sm font-semibold bg-yellow-100 text-yellow-800">
                                    <span class="material-icons text-sm">pending</span>
                                    Em Andamento
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-sm font-semibold bg-red-100 text-red-800">
                                    <span class="material-icons text-sm">warning</span>
                                    Sem Avaliador
                                </span>
                            }

                            <button class="bg-blue-600 text-white px-3 py-1 rounded text-sm hover:bg-blue-700"
                                    @onclick="() => DefinirAvaliador(p.CandidatoId)">
                                Definir
                            </button>
                        </div>
                    </div>

                    @if (p.Baremas.Any())
                    {
                        <div class="mt-3 pt-3 border-t border-gray-200">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                                @foreach (var b in p.Baremas)
                                {
                                    <div class="flex items-center justify-between bg-gray-50 rounded px-3 py-2 text-sm">
                                        <div class="flex items-center gap-2">
                                            <span class="material-icons text-gray-400 text-base">person</span>
                                            <span>@(b.AvaliadorNome ?? $"Avaliador #{b.AvaliadorId}")</span>
                                        </div>
                                        <div class="flex items-center gap-2">
                                            @if (b.Status == StatusBarema.Concluido)
                                            {
                                                <span class="font-semibold text-indigo-600">@b.NotaFinal.ToString("F1")</span>
                                            }
                                            <span class="inline-block px-2 py-0.5 rounded text-xs font-semibold text-white @GetStatusClass(b.Status)">@GetStatusLabel(b.Status)</span>
                                            @if (b.Status != StatusBarema.Concluido)
                                            {
                                                <button class="text-blue-600 hover:text-blue-800" title="Copiar link"
                                                        @onclick="() => CopiarLink(b.BaremaId)">
                                                    <span class="material-icons text-base">link</span>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
}

@code {
    private List<ProcessoSelecao> processos = new();
    private List<ProgressoCandidato> progresso = new();
    private bool carregando = true;
    private string? processoSelecionadoId;

    protected override async Task OnInitializedAsync()
    {
        processos = await ProcessoService.GetAllAsync();
        await LoadProgresso();
        carregando = false;
    }

    private async Task OnProcessoChanged()
    {
        carregando = true;
        StateHasChanged();
        await LoadProgresso();
        carregando = false;
    }

    private async Task LoadProgresso()
    {
        if (!string.IsNullOrEmpty(processoSelecionadoId) && int.TryParse(processoSelecionadoId, out var pid))
        {
            progresso = await BaremaService.GetProgressoAsync(pid);
        }
        else
        {
            progresso = await BaremaService.GetProgressoAsync();
        }
    }

    private void DefinirAvaliador(long candidatoId)
    {
        Nav.NavigateTo($"/admin/definir-avaliador");
    }

    private async Task CopiarLink(long baremaId)
    {
        var baseUrl = Nav.BaseUri.TrimEnd('/');
        var link = $"{baseUrl}/avaliador/avaliacao/{baremaId}";
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", link);
        await JS.InvokeVoidAsync("alert", $"Link copiado!\n\n{link}");
    }

    private string GetStatusLabel(StatusBarema s) => s switch
    {
        StatusBarema.Pendente => "Pendente",
        StatusBarema.EmPreenchimento => "Em Andamento",
        StatusBarema.Concluido => "Concluído",
        StatusBarema.Cancelado => "Cancelado",
        _ => "Desconhecido"
    };

    private string GetStatusClass(StatusBarema s) => s switch
    {
        StatusBarema.Pendente => "bg-yellow-500",
        StatusBarema.EmPreenchimento => "bg-cyan-600",
        StatusBarema.Concluido => "bg-green-600",
        StatusBarema.Cancelado => "bg-red-600",
        _ => "bg-gray-500"
    };
}
