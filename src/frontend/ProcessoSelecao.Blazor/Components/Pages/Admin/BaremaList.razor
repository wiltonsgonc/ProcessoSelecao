@page "/admin/baremas"
@using ProcessoSelecao.Blazor.Models
@using ProcessoSelecao.Blazor.Services
@layout Layouts.AdminLayout
@inject BaremaService Service
@inject BaremaTemplateService TemplateService
@inject CandidatoService CandidatoService
@inject ProcessoSelecaoService ProcessoService
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Baremas</PageTitle>

<div class="flex justify-between items-center mb-5">
    <h1 class="text-2xl font-bold">Baremas por Processo</h1>
    <button class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 transition-colors" @onclick="() => showForm = true">Novo Barema</button>
</div>

@if (carregando)
{
    <p class="text-gray-500">Carregando...</p>
}

@if (showForm && !carregando)
{
    <div class="bg-white border border-gray-200 rounded-lg p-5 mb-5">
        <h2 class="text-lg font-semibold mb-4">Novo Barema</h2>
        <form @onsubmit="Create" class="space-y-4">
            <div>
                <label class="block text-sm font-medium mb-1">Processo Seletivo</label>
                <select class="w-full px-3 py-2 border border-gray-300 rounded text-sm" @bind="formData.ProcessoSelecaoId" required>
                    <option value="">-- Selecione --</option>
                    @foreach (var p in processos)
                    {
                        <option value="@p.Id">@p.Nome (@p.TipoProcesso)</option>
                    }
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">Template de Avaliação (opcional)</label>
                <select class="w-full px-3 py-2 border border-gray-300 rounded text-sm" @bind="formData.TemplateId">
                    <option value="">-- Nenhum (barema fixo) --</option>
                    @foreach (var t in templatesAtivos)
                    {
                        <option value="@t.Id">@t.Nome (@t.TipoBarema - @t.TotalItens itens)</option>
                    }
                </select>
            </div>
            <div class="flex gap-2">
                <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">Criar</button>
                <button type="button" class="bg-gray-500 text-white px-4 py-2 rounded hover:bg-gray-600" @onclick="() => showForm = false">Cancelar</button>
            </div>
        </form>
    </div>
}

<div class="bg-white border border-gray-200 rounded-lg p-5">
    <div class="overflow-x-auto">
        <table class="w-full border-collapse">
            <thead>
                <tr class="bg-gray-50">
                    <th class="px-3 py-2.5 text-left font-semibold border-b border-gray-200">Processo</th>
                    <th class="px-3 py-2.5 text-left font-semibold border-b border-gray-200">Tipo</th>
                    <th class="px-3 py-2.5 text-left font-semibold border-b border-gray-200">Template</th>
                    <th class="px-3 py-2.5 text-left font-semibold border-b border-gray-200">Candidatos</th>
                    <th class="px-3 py-2.5 text-left font-semibold border-b border-gray-200">Baremas Criados</th>
                    <th class="px-3 py-2.5 text-left font-semibold border-b border-gray-200">Prazo</th>
                    <th class="px-3 py-2.5 text-left font-semibold border-b border-gray-200">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in processos)
                {
                    var candidatosDoProcesso = candidatos.Where(c => c.ProcessoSelecaoId == p.Id).ToList();
                    var baremasDoProcesso = baremas.Where(b => candidatosDoProcesso.Any(c => c.Id == b.CandidatoId)).ToList();
                    var templateSelecionado = templatesPorProcesso.GetValueOrDefault(p.Id);

                    <tr class="hover:bg-gray-50">
                        <td class="px-3 py-2.5 border-b border-gray-200 font-medium">@p.Nome</td>
                        <td class="px-3 py-2.5 border-b border-gray-200">
                            <span class="bg-blue-100 text-blue-800 text-xs px-2 py-1 rounded">@p.TipoProcesso</span>
                        </td>
                        <td class="px-3 py-2.5 border-b border-gray-200">
                            <select class="px-2 py-1 border border-gray-300 rounded text-xs"
                                    value="@templateSelecionado"
                                    @onchange="e => OnTemplateChanged(p.Id, e)">
                                <option value="">-- Fixo --</option>
                                @foreach (var t in templatesAtivos)
                                {
                                    <option value="@t.Id">@t.Nome</option>
                                }
                            </select>
                        </td>
                        <td class="px-3 py-2.5 border-b border-gray-200 text-center">@candidatosDoProcesso.Count</td>
                        <td class="px-3 py-2.5 border-b border-gray-200 text-center">
                            @if (baremasDoProcesso.Any())
                            {
                                <span class="text-green-700 font-semibold">@baremasDoProcesso.Count</span>
                            }
                            else
                            {
                                <span class="text-gray-400">0</span>
                            }
                        </td>
                        <td class="px-3 py-2.5 border-b border-gray-200 text-xs text-gray-500">
                            @FormatDate(p.DataInicio) – @FormatDate(p.DataFim)
                        </td>
                        <td class="px-3 py-2.5 border-b border-gray-200">
                            <div class="flex gap-1 flex-wrap">
                                <button class="bg-green-600 text-white px-2.5 py-1 rounded text-xs hover:bg-green-700"
                                        disabled="@(candidatosDoProcesso.Count == 0)"
                                        @onclick="() => DefinirBarema(p.Id)">
                                    Definir Barema
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<Barema> baremas = new();
    private List<Candidato> candidatos = new();
    private List<ProcessoSelecao> processos = new();
    private List<BaremaTemplate> templatesAtivos = new();
    private Dictionary<long, long?> templatesPorProcesso = new();
    private bool showForm = false;
    private CreateBarema formData = new();
    private bool carregando = true;

    protected override async Task OnInitializedAsync()
    {
        await Load();
        carregando = false;
    }

    private async Task Load()
    {
        carregando = true;
        processos = await ProcessoService.GetAllAsync();
        templatesAtivos = await TemplateService.GetActiveAsync();
        candidatos = await CandidatoService.GetAllAsync();
        baremas = await Service.GetAllAsync();

        templatesPorProcesso = new Dictionary<long, long?>();
        foreach (var p in processos)
        {
            var baremasDoProcesso = baremas.Where(b =>
                candidatos.Any(c => c.Id == b.CandidatoId && c.ProcessoSelecaoId == p.Id)
            ).ToList();

            templatesPorProcesso[p.Id] = baremasDoProcesso
                .Where(b => b.TemplateId.HasValue)
                .Select(b => b.TemplateId)
                .FirstOrDefault();
        }

        carregando = false;
    }

    private void OnTemplateChanged(long processoId, ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        long? templateId = string.IsNullOrEmpty(value) ? null : long.Parse(value);
        templatesPorProcesso[processoId] = templateId;
    }

    private async Task DefinirBarema(long processoId)
    {
        var templateId = templatesPorProcesso.GetValueOrDefault(processoId);
        await Service.CreateByProcessoAsync(processoId, templateId);
        await Load();
    }

    private async Task Create()
    {
        await Service.CreateByProcessoAsync(formData.ProcessoSelecaoId, formData.TemplateId);
        showForm = false; formData = new(); await Load();
    }

    private string FormatDate(string? dt) => DateTime.TryParse(dt, out var d) ? d.ToString("dd/MM/yyyy") : "-";
}
