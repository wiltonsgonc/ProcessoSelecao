@page "/admin/candidatos"
@using ProcessoSelecao.Blazor.Models
@layout Layouts.AdminLayout
@inject CandidatoService Service
@inject DocumentoService DocumentoService
@inject IJSRuntime JS

<div class="flex justify-between items-center mb-5">
    <h1 class="text-2xl font-bold">Candidatos</h1>
    <button class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 transition-colors" @onclick="ShowForm">Novo Candidato</button>
</div>

@if (showForm)
{
    <div class="bg-white border border-gray-200 rounded-lg p-5 mb-5">
        <h2 class="text-lg font-semibold mb-4">@(editingId.HasValue ? "Editar" : "Novo") Candidato</h2>
        <form @onsubmit="Save" class="space-y-4">
            <div>
                <label class="block text-sm font-medium mb-1">Nome</label>
                <input type="text" class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200" @bind="formData.Nome" required />
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">CPF</label>
                <input type="text" class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200 @(editingId.HasValue ? "bg-gray-100" : "")" @bind="formData.Cpf" readonly="@(editingId.HasValue)" required />
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">Email</label>
                <input type="email" class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200 @(editingId.HasValue ? "bg-gray-100" : "")" @bind="formData.Email" readonly="@(editingId.HasValue)" required />
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">Área de Pesquisa</label>
                <input type="text" class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200" @bind="formData.AreaPesquisa" />
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">ID do Processo</label>
                <input type="number" class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200 @(editingId.HasValue ? "bg-gray-100" : "")" @bind="formData.ProcessoSelecaoId" readonly="@(editingId.HasValue)" required />
            </div>
            <div class="flex gap-2">
                <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 transition-colors">Salvar</button>
                <button type="button" class="bg-gray-500 text-white px-4 py-2 rounded hover:bg-gray-600 transition-colors" @onclick="CancelForm">Cancelar</button>
            </div>
        </form>
    </div>
}

<div class="bg-white border border-gray-200 rounded-lg p-5">
    <div class="overflow-x-auto">
        <table class="w-full border-collapse">
            <thead>
                <tr class="bg-gray-50">
                    <th class="px-3 py-2.5 text-left font-semibold border-b border-gray-200">ID</th>
                    <th class="px-3 py-2.5 text-left font-semibold border-b border-gray-200">Nome</th>
                    <th class="px-3 py-2.5 text-left font-semibold border-b border-gray-200">CPF</th>
                    <th class="px-3 py-2.5 text-left font-semibold border-b border-gray-200">Email</th>
                    <th class="px-3 py-2.5 text-left font-semibold border-b border-gray-200">Status</th>
                    <th class="px-3 py-2.5 text-left font-semibold border-b border-gray-200">Pontuação</th>
                    <th class="px-3 py-2.5 text-left font-semibold border-b border-gray-200">Docs</th>
                    <th class="px-3 py-2.5 text-left font-semibold border-b border-gray-200">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in candidatos)
                {
                    <tr class="hover:bg-gray-50">
                        <td class="px-3 py-2.5 border-b border-gray-200">@c.Id</td>
                        <td class="px-3 py-2.5 border-b border-gray-200">@c.Nome</td>
                        <td class="px-3 py-2.5 border-b border-gray-200">@c.Cpf</td>
                        <td class="px-3 py-2.5 border-b border-gray-200">@c.Email</td>
                        <td class="px-3 py-2.5 border-b border-gray-200">
                            <span class="inline-block px-2 py-1 rounded text-xs font-semibold text-white @GetStatusClass(c.StatusValidacao)">@GetStatusLabel(c.StatusValidacao)</span>
                        </td>
                        <td class="px-3 py-2.5 border-b border-gray-200">@c.PontuacaoMedia.ToString("F2")</td>
                        <td class="px-3 py-2.5 border-b border-gray-200">@c.DocumentosValidados/@c.TotalDocumentos</td>
                        <td class="px-3 py-2.5 border-b border-gray-200">
                            <div class="flex gap-1 flex-wrap">
                                <button class="bg-cyan-600 text-white px-2.5 py-1 rounded text-xs hover:bg-cyan-700" @onclick="() => ShowDetail(c)">Detalhe</button>
                                <button class="bg-blue-600 text-white px-2.5 py-1 rounded text-xs hover:bg-blue-700" @onclick="() => Edit(c)">Editar</button>
                                <button class="bg-red-600 text-white px-2.5 py-1 rounded text-xs hover:bg-red-700" @onclick="() => Remove(c.Id)">Excluir</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (showModalDetail && selectedCandidato != null)
{
    <div class="fixed inset-0 bg-black/50 flex items-center justify-center z-50">
        <div class="bg-white rounded-lg p-6 max-w-2xl w-[90%] max-h-[80vh] overflow-y-auto">
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-lg font-semibold">Validação - @selectedCandidato.Nome</h3>
                <button class="text-2xl text-gray-500 hover:text-gray-700" @onclick="() => showModalDetail = false">&times;</button>
            </div>
            @if (documentos.Any())
            {
                <table class="w-full border-collapse">
                    <thead>
                        <tr class="bg-gray-50"><th class="px-3 py-2 text-left text-sm font-semibold border-b border-gray-200">Tipo</th><th class="px-3 py-2 text-left text-sm font-semibold border-b border-gray-200">Arquivo</th><th class="px-3 py-2 text-left text-sm font-semibold border-b border-gray-200">Status</th><th class="px-3 py-2 text-left text-sm font-semibold border-b border-gray-200">Motivo</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in documentos)
                        {
                            <tr>
                                <td class="px-3 py-2 border-b border-gray-100 text-sm">@GetTipoDocumentoLabel(doc.Tipo)</td>
                                <td class="px-3 py-2 border-b border-gray-100 text-sm">
                                    @doc.NomeArquivo
                                    @if (!string.IsNullOrEmpty(doc.LinkUrl)) { <a href="@doc.LinkUrl" target="_blank" class="ml-1 text-blue-600">(Link)</a> }
                                </td>
                                <td class="px-3 py-2 border-b border-gray-100 text-sm"><span class="inline-block px-2 py-0.5 rounded text-xs font-semibold text-white @GetDocStatusClass(doc)">@GetDocStatusLabel(doc)</span></td>
                                <td class="px-3 py-2 border-b border-gray-100 text-sm">@(doc.MotivoRejeicao ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else { <p class="text-gray-500">Nenhum documento encontrado.</p> }
        </div>
    </div>
}

@code {
    private List<Candidato> candidatos = new();
    private bool showForm = false;
    private int? editingId = null;
    private CreateCandidato formData = new();
    private bool showModalDetail = false;
    private Candidato? selectedCandidato;
    private List<Documento> documentos = new();

    protected override async Task OnInitializedAsync() => await Load();
    private async Task Load() => candidatos = await Service.GetAllAsync();

    private void ShowForm() { showForm = true; editingId = null; formData = new(); }

    private void Edit(Candidato c)
    {
        editingId = c.Id;
        formData = new CreateCandidato { Nome = c.Nome, Cpf = c.Cpf, Email = c.Email, AreaPesquisa = c.AreaPesquisa, ProcessoSelecaoId = c.ProcessoSelecaoId };
        showForm = true;
    }

    private async Task Save()
    {
        if (editingId.HasValue)
            await Service.UpdateAsync(editingId.Value, new UpdateCandidato { Nome = formData.Nome, AreaPesquisa = formData.AreaPesquisa });
        else
            await Service.CreateAsync(formData);
        CancelForm(); await Load();
    }

    private void CancelForm() { showForm = false; editingId = null; formData = new(); }

    private async Task Remove(int id)
    {
        if (await JS.InvokeAsync<bool>("confirm", "Deseja excluir este candidato?"))
        { await Service.DeleteAsync(id); await Load(); }
    }

    private async Task ShowDetail(Candidato c)
    {
        selectedCandidato = c; showModalDetail = true;
        documentos = await DocumentoService.GetByCandidatoIdAsync(c.Id);
    }

    private string GetStatusLabel(StatusValidacao s) => s switch
    {
        StatusValidacao.Pendente => "Pendente", StatusValidacao.Validado => "Validado",
        StatusValidacao.Rejeitado => "Rejeitado", StatusValidacao.EmAnalise => "Em Análise", _ => "Desconhecido"
    };

    private string GetStatusClass(StatusValidacao s) => s switch
    {
        StatusValidacao.Pendente => "bg-yellow-500", StatusValidacao.Validado => "bg-green-600",
        StatusValidacao.Rejeitado => "bg-red-600", StatusValidacao.EmAnalise => "bg-cyan-600", _ => "bg-gray-500"
    };

    private string GetTipoDocumentoLabel(TipoDocumento t) => t switch
    {
        TipoDocumento.HistoricoEscolar => "Histórico Escolar", TipoDocumento.ComprovanteMatricula => "Comprovante de Matrícula",
        TipoDocumento.CartaIntencao => "Carta de Intenção", TipoDocumento.CurriculumLatte => "Currículo Lattes",
        TipoDocumento.CartaRecomendacao => "Carta de Recomendação", _ => "Desconhecido"
    };

    private string GetDocStatusLabel(Documento d) => d.Validado ? "Validado" : !string.IsNullOrEmpty(d.MotivoRejeicao) ? "Rejeitado" : "Pendente";
    private string GetDocStatusClass(Documento d) => d.Validado ? "bg-green-600" : !string.IsNullOrEmpty(d.MotivoRejeicao) ? "bg-red-600" : "bg-yellow-500";
}
