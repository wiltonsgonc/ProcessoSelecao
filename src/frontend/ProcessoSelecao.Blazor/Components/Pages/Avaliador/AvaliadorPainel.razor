@page "/avaliador/painel"
@layout Layouts.AvaliadorLayout
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@using ProcessoSelecao.Blazor.Models

<PageTitle>Painel - Avaliador</PageTitle>

@if (carregando)
{
    <div class="text-center py-10">
        <span class="material-icons text-5xl text-gray-400 animate-spin">refresh</span>
        <p class="text-gray-500 mt-2">Carregando...</p>
    </div>
}
else if (baremas == null || !baremas.Any())
{
    <div class="text-center py-10">
        <span class="material-icons text-5xl text-gray-400">assignment_turned_in</span>
        <p class="text-gray-500 mt-2">Nenhuma avaliação atribuída.</p>
    </div>
}
else
{
    <div class="mb-6">
        <h2 class="text-xl font-bold text-gray-800">Suas Avaliações</h2>
        <p class="text-sm text-gray-500">@baremas.Count avaliação(ões) atribuída(s)</p>
    </div>

    <div class="grid gap-4">
        @foreach (var b in baremas)
        {
            <div class="bg-white border border-gray-200 rounded-lg p-5 hover:shadow-md transition-shadow">
                <div class="flex justify-between items-start">
                    <div class="flex-1">
                        <div class="flex items-center gap-2 mb-1">
                            <span class="font-semibold text-gray-800">@(b.CandidatoNome ?? "Candidato #" + b.CandidatoId)</span>
                            <span class="inline-block px-2 py-0.5 rounded text-xs font-semibold text-white @GetStatusClass(b.Status)">
                                @GetStatusLabel(b.Status)
                            </span>
                        </div>
                        @if (b.Status == StatusBarema.Concluido)
                        {
                            <p class="text-sm text-gray-500">Nota: <span class="font-semibold text-indigo-600">@b.NotaFinal.ToString("F2")</span></p>
                        }
                        else
                        {
                            <p class="text-sm text-gray-500">Aguardando avaliação</p>
                        }
                    </div>
                    @if (b.Status != StatusBarema.Concluido)
                    {
                        <button class="bg-indigo-600 text-white px-4 py-2 rounded text-sm hover:bg-indigo-700 transition-colors"
                                @onclick="() => Avaliar(b.Id)">
                            Avaliar
                        </button>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    private List<AvaliadorPainelBarema>? baremas;
    private bool carregando = true;

    protected override async Task OnInitializedAsync()
    {
        var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "avaliador_token");
        if (string.IsNullOrEmpty(token))
        {
            Nav.NavigateTo("/avaliador/login");
            return;
        }

        try
        {
            var baseUrl = "http://localhost:5002";
            var request = new HttpRequestMessage(HttpMethod.Get, $"{baseUrl}/api/avaliador-painel/baremas");
            request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                baremas = await response.Content.ReadFromJsonAsync<List<AvaliadorPainelBarema>>();
            }
        }
        catch { }
        finally
        {
            carregando = false;
        }
    }

    private void Avaliar(long baremaId)
    {
        Nav.NavigateTo($"/avaliador/avaliacao/{baremaId}");
    }

    private string GetStatusLabel(StatusBarema s) => s switch
    {
        StatusBarema.Pendente => "Pendente",
        StatusBarema.EmPreenchimento => "Em Andamento",
        StatusBarema.Concluido => "Concluído",
        StatusBarema.Cancelado => "Cancelado",
        _ => "Desconhecido"
    };

    private string GetStatusClass(StatusBarema s) => s switch
    {
        StatusBarema.Pendente => "bg-yellow-500",
        StatusBarema.EmPreenchimento => "bg-cyan-600",
        StatusBarema.Concluido => "bg-green-600",
        StatusBarema.Cancelado => "bg-red-600",
        _ => "bg-gray-500"
    };
}
