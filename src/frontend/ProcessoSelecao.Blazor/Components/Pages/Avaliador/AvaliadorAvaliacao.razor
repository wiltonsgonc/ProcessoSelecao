        salvando = true;
        erro = "";
        sucesso = false;

        try
        {
            var baseUrl = "http://localhost:5002";

            var criterios = new Dictionary<string, object>
            {
                { "analiseDocumental", analiseDocumental },
                { "projeto", new Dictionary<string, double>
                    {
                        { "1_1", p1_1 }, { "1_2", p1_2 }, { "1_3", p1_3 },
                        { "1_4", p1_4 }, { "1_5", p1_5 }, { "1_6", p1_6 }
                    }
                },
