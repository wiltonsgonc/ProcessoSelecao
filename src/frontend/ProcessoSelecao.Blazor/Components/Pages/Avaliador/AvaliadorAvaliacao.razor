@page "/avaliador/avaliacao/{baremaId:long}"
@layout Layouts.AvaliadorLayout
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@using ProcessoSelecao.Blazor.Models
@using System.Text.Json
@using System.Text

<PageTitle>Avaliação</PageTitle>

@if (carregando)
{
    <div class="text-center py-10">
        <span class="material-icons text-5xl text-gray-400 animate-spin">refresh</span>
        <p class="text-gray-500 mt-2">Carregando avaliação...</p>
    </div>
}
else if (barema == null || candidato == null)
{
    <div class="text-center py-10">
        <p class="text-red-500">Erro ao carregar dados da avaliação.</p>
        <button class="mt-4 text-indigo-600 hover:underline" @onclick='() => Nav.NavigateTo("/avaliador/painel")'>Voltar ao painel</button>
    </div>
}
else
{
    <div class="mb-4">
        <button class="text-sm text-indigo-600 hover:text-indigo-800 flex items-center gap-1" @onclick='() => Nav.NavigateTo("/avaliador/painel")'>
            <span class="material-icons text-base">arrow_back</span> Voltar ao painel
        </button>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-6">
        <!-- Lado esquerdo: Documentos e dados do candidato -->
        <div class="lg:col-span-3 space-y-4">
            <div class="bg-white border border-gray-200 rounded-lg p-5">
                <h3 class="font-bold text-gray-800 mb-3">Dados do Candidato</h3>
                <div class="grid grid-cols-2 gap-3 text-sm">
                    <div><span class="text-gray-500">Nome:</span> <span class="font-medium">@candidato.Nome</span></div>
                    <div><span class="text-gray-500">Email:</span> <span class="font-medium">@candidato.Email</span></div>
                    <div><span class="text-gray-500">Área de Pesquisa:</span> <span class="font-medium">@(candidato.AreaPesquisa ?? "-")</span></div>
                    <div><span class="text-gray-500">Título do Projeto:</span> <span class="font-medium">@(candidato.TituloProjeto ?? "-")</span></div>
                </div>
            </div>

            <div class="bg-white border border-gray-200 rounded-lg p-5">
                <h3 class="font-bold text-gray-800 mb-3">Documentos do Candidato</h3>
                @if (documentos != null && documentos.Any())
                {
                    @foreach (var doc in documentos)
                    {
                        <div class="flex items-center justify-between py-2 border-b border-gray-100 last:border-0">
                            <div class="flex items-center gap-2">
                                <span class="material-icons text-red-500 text-base">picture_as_pdf</span>
                                <span class="text-sm font-medium">@doc.NomeArquivo</span>
                                <span class="text-xs text-gray-400">(@GetTipoLabel((int)doc.Tipo))</span>
                            </div>
                            <div class="flex gap-2">
                                <button class="text-indigo-600 hover:text-indigo-800 text-xs" @onclick="() => VisualizarPdf(doc.Id)">
                                    Visualizar
                                </button>
                                <a href="@GetDownloadUrl(doc.Id)" target="_blank" class="text-gray-500 hover:text-gray-700 text-xs">
                                    Download
                                </a>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-sm text-gray-500">Nenhum documento encontrado.</p>
                }
            </div>

            <!-- PDF Viewer -->
            @if (pdfVisualizando)
            {
                <div class="bg-white border border-gray-200 rounded-lg p-5">
                    <div class="flex justify-between items-center mb-3">
                        <h3 class="font-bold text-gray-800">Visualizando Documento</h3>
                        <button class="text-gray-500 hover:text-gray-700" @onclick="() => pdfVisualizando = false">
                            <span class="material-icons">close</span>
                        </button>
                    </div>
                    <iframe src="@pdfUrl" class="w-full h-[600px] border border-gray-200 rounded"></iframe>
                </div>
            }
        </div>

        <!-- Lado direito: Formulário de avaliação -->
        <div class="lg:col-span-2">
            <div class="bg-white border border-gray-200 rounded-lg p-5 sticky top-6">
                <h3 class="font-bold text-gray-800 mb-4">Avaliação</h3>

                @if (!string.IsNullOrEmpty(erro))
                {
                    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded mb-4 text-sm">@erro</div>
                }

                @if (sucesso)
                {
                    <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded mb-4 text-sm">
                        Avaliação finalizada com sucesso!
                        <button class="ml-2 underline" @onclick='() => Nav.NavigateTo("/avaliador/painel")'>Voltar ao painel</button>
                    </div>
                }

                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium mb-1">Originalidade (0-10)</label>
                        <input type="range" min="0" max="10" step="0.5" class="w-full" @bind="originalidade" />
                        <span class="text-sm text-gray-600">@originalidade.ToString("F1")</span>
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">Relevância (0-10)</label>
                        <input type="range" min="0" max="10" step="0.5" class="w-full" @bind="relevancia" />
                        <span class="text-sm text-gray-600">@relevancia.ToString("F1")</span>
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">Metodologia (0-10)</label>
                        <input type="range" min="0" max="10" step="0.5" class="w-full" @bind="metodologia" />
                        <span class="text-sm text-gray-600">@metodologia.ToString("F1")</span>
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">Apresentação (0-10)</label>
                        <input type="range" min="0" max="10" step="0.5" class="w-full" @bind="apresentacao" />
                        <span class="text-sm text-gray-600">@apresentacao.ToString("F1")</span>
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">Média</label>
                        <span class="text-lg font-bold text-indigo-600">@CalcularMedia().ToString("F2")</span>
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">Observações</label>
                        <textarea class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 min-h-[80px]" @bind="observacoes"></textarea>
                    </div>
                    <button class="w-full bg-indigo-600 text-white px-4 py-2 rounded hover:bg-indigo-700 transition-colors font-medium" @onclick="Finalizar" disabled="@salvando">
                        @if (salvando) { <span>Salvando...</span> } else { <span>Finalizar Avaliação</span> }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public long baremaId { get; set; }

    private AvaliadorPainelBarema? barema;
    private AvaliadorCandidatoInfo? candidato;
    private List<Models.Documento>? documentos;

    private bool carregando = true;
    private bool salvando = false;
    private bool sucesso = false;
    private string erro = "";

    private double originalidade = 5;
    private double relevancia = 5;
    private double metodologia = 5;
    private double apresentacao = 5;
    private string observacoes = "";

    private bool pdfVisualizando = false;
    private string pdfUrl = "";

    private string _token = "";

    protected override async Task OnInitializedAsync()
    {
        _token = await JS.InvokeAsync<string>("sessionStorage.getItem", "avaliador_token");
        if (string.IsNullOrEmpty(_token))
        {
            Nav.NavigateTo("/avaliador/login");
            return;
        }

        await CarregarDados();
    }

    private async Task CarregarDados()
    {
        carregando = true;
        try
        {
            var baseUrl = "http://localhost:5002";

            // Carrega barema
            var reqBarema = new HttpRequestMessage(HttpMethod.Get, $"{baseUrl}/api/baremas/{baremaId}");
            reqBarema.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _token);
            var resBarema = await Http.SendAsync(reqBarema);
            if (resBarema.IsSuccessStatusCode)
            {
                barema = await resBarema.Content.ReadFromJsonAsync<AvaliadorPainelBarema>();
            }

            if (barema != null)
            {
                // Carrega dados do candidato
                var reqCandidato = new HttpRequestMessage(HttpMethod.Get, $"{baseUrl}/api/avaliador-painel/candidato/{barema.CandidatoId}");
                reqCandidato.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _token);
                var resCandidato = await Http.SendAsync(reqCandidato);
                if (resCandidato.IsSuccessStatusCode)
                {
                    candidato = await resCandidato.Content.ReadFromJsonAsync<AvaliadorCandidatoInfo>();
                }

                // Carrega documentos do candidato
                var reqDocs = new HttpRequestMessage(HttpMethod.Get, $"{baseUrl}/api/avaliador-painel/documentos/{barema.CandidatoId}");
                reqDocs.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _token);
                var resDocs = await Http.SendAsync(reqDocs);
                if (resDocs.IsSuccessStatusCode)
                {
                    documentos = await resDocs.Content.ReadFromJsonAsync<List<Models.Documento>>();
                }
            }
        }
        catch (Exception ex)
        {
            erro = $"Erro ao carregar: {ex.Message}";
        }
        finally
        {
            carregando = false;
        }
    }

    private async Task VisualizarPdf(long documentoId)
    {
        var baseUrl = "http://localhost:5002";
        var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "avaliador_token");

        // Download do PDF e conversão para base64
        var request = new HttpRequestMessage(HttpMethod.Get, $"{baseUrl}/api/avaliador-painel/documentos/{documentoId}/download");
        request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

        var response = await Http.SendAsync(request);
        if (response.IsSuccessStatusCode)
        {
            var bytes = await response.Content.ReadAsByteArrayAsync();
            var base64 = Convert.ToBase64String(bytes);
            pdfUrl = $"data:application/pdf;base64,{base64}";
            pdfVisualizando = true;
        }
    }

    private string GetDownloadUrl(long documentoId)
    {
        return $"http://localhost:5002/api/avaliador-painel/documentos/{documentoId}/download";
    }

    private double CalcularMedia()
    {
        return (originalidade + relevancia + metodologia + apresentacao) / 4.0;
    }

    private async Task Finalizar()
    {
        salvando = true;
        erro = "";
        sucesso = false;

        try
        {
            var baseUrl = "http://localhost:5002";
            var criterios = new Dictionary<string, double>
            {
                { "Originalidade", originalidade },
                { "Relevancia", relevancia },
                { "Metodologia", metodologia },
                { "Apresentacao", apresentacao }
            };

            var request = new HttpRequestMessage(HttpMethod.Post, $"{baseUrl}/api/avaliador-painel/baremas/{baremaId}/finalizar");
            request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _token);
            request.Content = new StringContent(
                JsonSerializer.Serialize(new { Criterios = criterios, Observacoes = observacoes }),
                Encoding.UTF8,
                "application/json");

            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                sucesso = true;
            }
            else
            {
                var msg = await response.Content.ReadAsStringAsync();
                erro = $"Erro ao salvar: {msg}";
            }
        }
        catch (Exception ex)
        {
            erro = $"Erro ao finalizar: {ex.Message}";
        }
        finally
        {
            salvando = false;
        }
    }

    private string GetTipoLabel(int tipo) => tipo switch
    {
        1 => "Histórico Escolar",
        2 => "Comprovante de Matrícula",
        3 => "Carta de Intenção",
        4 => "Currículo Lattes",
        5 => "Carta de Recomendação",
        _ => "Documento"
    };
}
