@page "/avaliador/avaliacao/{baremaId:long}"
@layout Layouts.AvaliadorLayout
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IWebHostEnvironment Environment
@using ProcessoSelecao.Blazor.Models
@using ProcessoSelecao.Blazor.Services
@using System.Text.Json
@using System.Text

<PageTitle>Avaliação PIBIC</PageTitle>

@if (carregando)
{
    <div class="text-center py-10">
        <span class="material-icons text-5xl text-gray-400 animate-spin">refresh</span>
        <p class="text-gray-500 mt-2">Carregando avaliação...</p>
    </div>
}
else if (barema == null || candidato == null)
{
    <div class="text-center py-10">
        <p class="text-red-500">Erro ao carregar dados da avaliação.</p>
        <button class="mt-4 text-indigo-600 hover:underline" @onclick='() => Nav.NavigateTo("/avaliador/painel")'>Voltar ao painel</button>
    </div>
}
else
{
    <div class="mb-4">
        <button class="text-sm text-indigo-600 hover:text-indigo-800 flex items-center gap-1" @onclick='() => Nav.NavigateTo("/avaliador/painel")'>
            <span class="material-icons text-base">arrow_back</span> Voltar ao painel
        </button>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-6">
        <!-- Lado esquerdo: Documentos e dados do candidato -->
        <div class="lg:col-span-3 space-y-4">
            <div class="bg-white border border-gray-200 rounded-lg p-5">
                <h3 class="font-bold text-gray-800 mb-3">Dados do Candidato</h3>
                <div class="grid grid-cols-2 gap-3 text-sm">
                    <div><span class="text-gray-500">Nome:</span> <span class="font-medium">@candidato.Nome</span></div>
                    <div><span class="text-gray-500">Email:</span> <span class="font-medium">@candidato.Email</span></div>
                    <div><span class="text-gray-500">Área de Pesquisa:</span> <span class="font-medium">@(candidato.AreaPesquisa ?? "-")</span></div>
                    <div><span class="text-gray-500">Título do Projeto:</span> <span class="font-medium">@(candidato.TituloProjeto ?? "-")</span></div>
                </div>
            </div>

            <div class="bg-white border border-gray-200 rounded-lg p-5">
                <h3 class="font-bold text-gray-800 mb-3">Documentos do Candidato</h3>
                @if (documentos != null && documentos.Any())
                {
                    @foreach (var doc in documentos)
                    {
                        <div class="flex items-center justify-between py-2 border-b border-gray-100 last:border-0">
                            <div class="flex items-center gap-2">
                                <span class="material-icons text-red-500 text-base">picture_as_pdf</span>
                                <span class="text-sm font-medium">@doc.NomeArquivo</span>
                                <span class="text-xs text-gray-400">(@GetTipoLabel((int)doc.Tipo))</span>
                            </div>
                            <div class="flex gap-2">
                                <button class="text-indigo-600 hover:text-indigo-800 text-xs" @onclick="() => VisualizarPdf(doc.Id)">
                                    Visualizar
                                </button>
                                <a href="@GetDownloadUrl(doc.Id)" target="_blank" class="text-gray-500 hover:text-gray-700 text-xs">
                                    Download
                                </a>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-sm text-gray-500">Nenhum documento encontrado.</p>
                }
            </div>

            <!-- PDF Viewer -->
            @if (pdfVisualizando)
            {
                <div class="bg-white border border-gray-200 rounded-lg p-5">
                    <div class="flex justify-between items-center mb-3">
                        <h3 class="font-bold text-gray-800">Visualizando Documento</h3>
                        <button class="text-gray-500 hover:text-gray-700" @onclick="() => pdfVisualizando = false">
                            <span class="material-icons">close</span>
                        </button>
                    </div>
                    <iframe src="@pdfUrl" class="w-full h-[600px] border border-gray-200 rounded"></iframe>
                </div>
            }
        </div>

        <!-- Lado direito: Formulário de avaliação PIBIC -->
        <div class="lg:col-span-2">
            <div class="bg-white border border-gray-200 rounded-lg p-5 sticky top-6">
                <h3 class="font-bold text-gray-800 mb-4">BAREMA PIBIC - QUALIFICAÇÃO DO PROJETO E DO ORIENTADOR</h3>

                @if (!string.IsNullOrEmpty(erro))
                {
                    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded mb-4 text-sm">@erro</div>
                }

                @if (sucesso)
                {
                    <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded mb-4 text-sm">
                        Avaliação finalizada com sucesso!
                        <button class="ml-2 underline" @onclick='() => Nav.NavigateTo("/avaliador/painel")'>Voltar ao painel</button>
                    </div>
                }

                <!-- Cabeçalho automático -->
                <div class="grid grid-cols-2 gap-3 mb-4 p-3 bg-gray-50 rounded">
                    <div>
                        <label class="block text-xs font-medium text-gray-500">NOME DO ORIENTADOR</label>
                        <p class="text-sm font-medium">@(nomeOrientador ?? "-")</p>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500">NOME DO ESTUDANTE</label>
                        <p class="text-sm font-medium">@(nomeEstudante ?? "-")</p>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500">CURSO DE GRADUAÇÃO</label>
                        <p class="text-sm font-medium">@(cursoGraduacao ?? "-")</p>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500">AVALIADOR</label>
                        <p class="text-sm font-medium">@(nomeAvaliador ?? "-")</p>
                    </div>
                </div>

                @if (templateAtivo != null)
                {
                    <!-- TEMPLATE-BASED FORM -->
                    <h4 class="font-bold text-sm mb-3">@templateAtivo.Nome</h4>

                    @if (templateAtivo.Itens.Any())
                    {
                        var secoes = templateAtivo.Itens.GroupBy(i => i.SecaoOrdem).OrderBy(g => g.Key);
                        @foreach (var secao in secoes)
                        {
                            var soma = somasSecao.GetValueOrDefault(secao.Key);
                            <div class="mb-4 p-3 border border-gray-200 rounded">
                                <h4 class="font-bold text-sm mb-2">@secao.First().Secao (máx @secao.Sum(i => i.NotaMaxima) pts)</h4>
                                <div class="space-y-2">
                                    @foreach (var item in secao.OrderBy(i => i.Ordem))
                                    {
                                        var valorAtual = avaliacoesTemplate.GetValueOrDefault(item.Id);
                                        <div class="flex items-center justify-between gap-2">
                                            <label class="text-xs flex-1">@item.Nome (0-@item.NotaMaxima)</label>
                                            <input type="number"
                                                   min="@item.NotaMinima"
                                                   max="@item.NotaMaxima"
                                                   step="@item.Passo"
                                                   class="w-16 px-2 py-1 border rounded text-center text-sm"
                                                   value="@valorAtual"
                                                   @onchange="e => OnTemplateItemChange(item.Id, e)" />
                                        </div>
                                    }
                                    <div class="flex items-center justify-between gap-2 pt-2 border-t font-bold text-sm">
                                        <span>TOTAL PARCIAL (máx @secao.Sum(i => i.NotaMaxima))</span>
                                        <span class="text-indigo-600">@soma.ToString("F1")</span>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- TOTAL GERAL -->
                        <div class="mb-4 p-3 bg-indigo-50 border border-indigo-200 rounded">
                            <div class="flex items-center justify-between font-bold">
                                <span>NOTA FINAL (média dos itens)</span>
                                <span class="text-lg text-indigo-600">@CalcularNotaFinalTemplate().ToString("F2")</span>
                            </div>
                        </div>
                    }

                    <!-- Observações -->
                    <div class="mb-4">
                        <label class="block text-sm font-medium mb-1">Observações</label>
                        <textarea class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 min-h-[80px]" @bind="observacoes"></textarea>
                    </div>

                    <button class="w-full bg-indigo-600 text-white px-4 py-2 rounded hover:bg-indigo-700 transition-colors font-medium" @onclick="FinalizarComTemplate" disabled="@salvando">
                        @if (salvando) { <span>Salvando...</span> } else { <span>Finalizar Avaliação</span> }
                    </button>
                }
                else
                {
                    <!-- LEGACY PIBIC FORM (fallback for baremas without template) -->
                <div class="mb-4 p-3 border border-gray-200 rounded">
                    <h4 class="font-bold text-sm mb-2">ANÁLISE DOCUMENTAL</h4>
                    <p class="text-sm mb-2">Todos os documentos foram entregues de acordo com o EDITAL.</p>
                    <div class="flex gap-4">
                        <label class="flex items-center gap-1 text-sm">
                            <input type="radio" name="analiseDoc" value="classificado" @onchange="OnAnaliseDocChange" checked="@(analiseDocumental == "classificado")" />
                            CLASSIFICADO (sim)
                        </label>
                        <label class="flex items-center gap-1 text-sm">
                            <input type="radio" name="analiseDoc" value="eliminado" @onchange="OnAnaliseDocChange" checked="@(analiseDocumental == "eliminado")" />
                            ELIMINADO (não)
                        </label>
                    </div>
                </div>

                @if (analiseDocumental != "eliminado")
                {
                    <!-- 1. PROJETO -->
                    <div class="mb-4 p-3 border border-gray-200 rounded">
                        <h4 class="font-bold text-sm mb-2">1. PROJETO (máx 35 pts)</h4>
                        <div class="space-y-2">
                            <div class="flex items-center justify-between gap-2">
                                <label class="text-xs flex-1">1.1 Relação c/ projeto SENAI (0/5/10)</label>
                                <input type="number" min="0" max="10" step="1" class="w-16 px-2 py-1 border rounded text-center text-sm" @bind="p1_1" @bind:after="CalcularTotais" />
                            </div>
                            <div class="flex items-center justify-between gap-2">
                                <label class="text-xs flex-1">1.2 Resumo (0-5)</label>
                                <input type="number" min="0" max="5" step="0.5" class="w-16 px-2 py-1 border rounded text-center text-sm" @bind="p1_2" @bind:after="CalcularTotais" />
                            </div>
                            <div class="flex items-center justify-between gap-2">
                                <label class="text-xs flex-1">1.3 Objetivos (0-5)</label>
                                <input type="number" min="0" max="5" step="0.5" class="w-16 px-2 py-1 border rounded text-center text-sm" @bind="p1_3" @bind:after="CalcularTotais" />
                            </div>
                            <div class="flex items-center justify-between gap-2">
                                <label class="text-xs flex-1">1.4 Metodologia (0-5)</label>
                                <input type="number" min="0" max="5" step="0.5" class="w-16 px-2 py-1 border rounded text-center text-sm" @bind="p1_4" @bind:after="CalcularTotais" />
                            </div>
                            <div class="flex items-center justify-between gap-2">
                                <label class="text-xs flex-1">1.5 Relevância (0-5)</label>
                                <input type="number" min="0" max="5" step="0.5" class="w-16 px-2 py-1 border rounded text-center text-sm" @bind="p1_5" @bind:after="CalcularTotais" />
                            </div>
                            <div class="flex items-center justify-between gap-2">
                                <label class="text-xs flex-1">1.6 Exequibilidade (0-5)</label>
                                <input type="number" min="0" max="5" step="0.5" class="w-16 px-2 py-1 border rounded text-center text-sm" @bind="p1_6" @bind:after="CalcularTotais" />
                            </div>
                            <div class="flex items-center justify-between gap-2 pt-2 border-t font-bold text-sm">
                                <span>TOTAL PARCIAL (máx 35)</span>
                                <span class="text-indigo-600">@soma1.ToString("F1")</span>
                            </div>
                        </div>
                    </div>

                    <!-- 2. ORIENTADOR -->
                    <div class="mb-4 p-3 border border-gray-200 rounded">
                        <h4 class="font-bold text-sm mb-2">2. ORIENTADOR (máx 35 pts)</h4>
                        <div class="space-y-2">
                            <div class="flex items-center justify-between gap-2">
                                <label class="text-xs flex-1">2.1 Grau titulação (3/5)</label>
                                <input type="number" min="0" max="5" step="1" class="w-16 px-2 py-1 border rounded text-center text-sm" @bind="p2_1" @bind:after="CalcularTotais" />
                            </div>
                            <div class="flex items-center justify-between gap-2">
                                <label class="text-xs flex-1">2.2 Projeto relacionado (0/5)</label>
                                <input type="number" min="0" max="5" step="5" class="w-16 px-2 py-1 border rounded text-center text-sm" @bind="p2_2" @bind:after="CalcularTotais" />
                            </div>
                            <div class="flex items-center justify-between gap-2">
                                <label class="text-xs flex-1">2.3 Experiência docente (0/5)</label>
                                <input type="number" min="0" max="5" step="5" class="w-16 px-2 py-1 border rounded text-center text-sm" @bind="p2_3" @bind:after="CalcularTotais" />
                            </div>
                            <div class="flex items-center justify-between gap-2">
                                <label class="text-xs flex-1">2.4 Coordenação projetos (3/7/10)</label>
                                <input type="number" min="0" max="10" step="1" class="w-16 px-2 py-1 border rounded text-center text-sm" @bind="p2_4" @bind:after="CalcularTotais" />
                            </div>
                            <div class="flex items-center justify-between gap-2">
                                <label class="text-xs flex-1">2.5 Produção técnico-científica (0-10)</label>
                                <input type="number" min="0" max="10" step="1" class="w-16 px-2 py-1 border rounded text-center text-sm" @bind="p2_5" @bind:after="CalcularTotais" />
                            </div>
                            <div class="flex items-center justify-between gap-2 pt-2 border-t font-bold text-sm">
                                <span>TOTAL PARCIAL (máx 35)</span>
                                <span class="text-indigo-600">@soma2.ToString("F1")</span>
                            </div>
                        </div>
                    </div>

                    <!-- 3. CANDIDATO -->
                    <div class="mb-4 p-3 border border-gray-200 rounded">
                        <h4 class="font-bold text-sm mb-2">3. CANDIDATO (máx 30 pts)</h4>
                        <div class="space-y-2">
                            <div class="flex items-center justify-between gap-2">
                                <label class="text-xs flex-1">3.1 Participação IC/IT (0/5)</label>
                                <input type="number" min="0" max="5" step="5" class="w-16 px-2 py-1 border rounded text-center text-sm" @bind="p3_1" @bind:after="CalcularTotais" />
                            </div>
                            <div class="flex items-center justify-between gap-2">
                                <label class="text-xs flex-1">3.2 Publicações (0-5, step 2)</label>
                                <input type="number" min="0" max="5" step="2" class="w-16 px-2 py-1 border rounded text-center text-sm" @bind="p3_2" @bind:after="CalcularTotais" />
                            </div>
                            <div class="flex items-center justify-between gap-2">
                                <label class="text-xs flex-1">3.3 Congressos (0-5, step 1)</label>
                                <input type="number" min="0" max="5" step="1" class="w-16 px-2 py-1 border rounded text-center text-sm" @bind="p3_3" @bind:after="CalcularTotais" />
                            </div>
                            <div class="flex items-center justify-between gap-2">
                                <label class="text-xs flex-1">3.4 Desempenho acadêmico (3/6/15)</label>
                                <input type="number" min="0" max="15" step="3" class="w-16 px-2 py-1 border rounded text-center text-sm" @bind="p3_4" @bind:after="CalcularTotais" />
                            </div>
                            <div class="flex items-center justify-between gap-2 pt-2 border-t font-bold text-sm">
                                <span>TOTAL PARCIAL (máx 30)</span>
                                <span class="text-indigo-600">@soma3.ToString("F1")</span>
                            </div>
                        </div>
                    </div>

                    <!-- SOMATÓRIO TOTAL -->
                    <div class="mb-4 p-3 bg-indigo-50 border border-indigo-200 rounded">
                        <div class="flex items-center justify-between font-bold">
                            <span>SOMATÓRIO TOTAL</span>
                            <span class="text-lg text-indigo-600">@totalGeral.ToString("F1")</span>
                        </div>
                    </div>

                    <!-- Observações -->
                    <div class="mb-4">
                        <label class="block text-sm font-medium mb-1">Observações</label>
                        <textarea class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 min-h-[80px]" @bind="observacoes"></textarea>
                    </div>

                    <button class="w-full bg-indigo-600 text-white px-4 py-2 rounded hover:bg-indigo-700 transition-colors font-medium" @onclick="Finalizar" disabled="@salvando">
                        @if (salvando) { <span>Salvando...</span> } else { <span>Finalizar Avaliação</span> }
                    </button>
                }
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public long baremaId { get; set; }

    private AvaliadorPainelBarema? barema;
    private AvaliadorCandidatoInfo? candidato;
    private List<Models.Documento>? documentos;

    private bool carregando = true;
    private bool salvando = false;
    private bool sucesso = false;
    private string erro = "";

    private string? nomeOrientador;
    private string? nomeEstudante;
    private string? cursoGraduacao;
    private string? nomeAvaliador;

    // Template-based form
    private BaremaTemplate? templateAtivo;
    private Dictionary<long, double> avaliacoesTemplate = new();
    private Dictionary<int, double> somasSecao = new();

    // Legacy PIBIC form
    private string analiseDocumental = "";

    private double p1_1, p1_2, p1_3, p1_4, p1_5, p1_6;
    private double p2_1, p2_2, p2_3, p2_4, p2_5;
    private double p3_1, p3_2, p3_3, p3_4;

    private double soma1, soma2, soma3, totalGeral;
    private string observacoes = "";

    private bool pdfVisualizando = false;
    private string pdfUrl = "";

    private string _token = "";

    protected override async Task OnInitializedAsync()
    {
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        if (Environment.IsDevelopment())
        {
            _token = "dev-bypass-token";
        }
        else
        {
            _token = await JS.InvokeAsync<string>("sessionStorage.getItem", "avaliador_token");
            if (string.IsNullOrEmpty(_token))
            {
                Nav.NavigateTo("/avaliador/login");
                return;
            }
        }

        await CarregarDados();
        StateHasChanged();
    }

    private async Task CarregarDados()
    {
        carregando = true;
        try
        {
            var baseUrl = "http://localhost:5002";

            // Carrega dados do barema (com auto-preenchimento)
            var reqDados = new HttpRequestMessage(HttpMethod.Get, $"{baseUrl}/api/avaliador-painel/barema-dados/{baremaId}");
            reqDados.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _token);
            var resDados = await Http.SendAsync(reqDados);
            if (resDados.IsSuccessStatusCode)
            {
                var dados = await resDados.Content.ReadFromJsonAsync<BaremaDadosDto>(JsonOptions.Default);
                if (dados != null)
                {
                    nomeOrientador = dados.NomeOrientador;
                    nomeEstudante = dados.NomeEstudante;
                    cursoGraduacao = dados.CursoGraduacao;
                    nomeAvaliador = dados.NomeAvaliador;
                }
            }

            // Carrega barema básico
            var reqBarema = new HttpRequestMessage(HttpMethod.Get, $"{baseUrl}/api/baremas/{baremaId}");
            reqBarema.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _token);
            var resBarema = await Http.SendAsync(reqBarema);
            if (resBarema.IsSuccessStatusCode)
            {
                barema = await resBarema.Content.ReadFromJsonAsync<AvaliadorPainelBarema>(JsonOptions.Default);
            }

            if (barema != null)
            {
                // Load template if barema has one
                if (barema.TemplateId.HasValue)
                {
                    var reqTemplate = new HttpRequestMessage(HttpMethod.Get, $"{baseUrl}/api/barematemplates/{barema.TemplateId}");
                    reqTemplate.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _token);
                    var resTemplate = await Http.SendAsync(reqTemplate);
                    if (resTemplate.IsSuccessStatusCode)
                    {
                        templateAtivo = await resTemplate.Content.ReadFromJsonAsync<BaremaTemplate>(JsonOptions.Default);
                        if (templateAtivo != null)
                        {
                            foreach (var item in templateAtivo.Itens)
                            {
                                avaliacoesTemplate[item.Id] = 0;
                            }
                            CalcularSecoesTemplate();
                        }
                    }
                }

                // Carrega dados do candidato
                var reqCandidato = new HttpRequestMessage(HttpMethod.Get, $"{baseUrl}/api/avaliador-painel/candidato/{barema.CandidatoId}");
                reqCandidato.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _token);
                var resCandidato = await Http.SendAsync(reqCandidato);
                if (resCandidato.IsSuccessStatusCode)
                {
                    candidato = await resCandidato.Content.ReadFromJsonAsync<AvaliadorCandidatoInfo>(JsonOptions.Default);
                }

                // Carrega documentos do candidato
                var reqDocs = new HttpRequestMessage(HttpMethod.Get, $"{baseUrl}/api/avaliador-painel/documentos/{barema.CandidatoId}");
                reqDocs.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _token);
                var resDocs = await Http.SendAsync(reqDocs);
                if (resDocs.IsSuccessStatusCode)
                {
                    documentos = await resDocs.Content.ReadFromJsonAsync<List<Models.Documento>>(JsonOptions.Default);
                }
            }
        }
        catch (Exception ex)
        {
            erro = $"Erro ao carregar: {ex.Message}";
        }
        finally
        {
            carregando = false;
        }
    }

    private void OnAnaliseDocChange(ChangeEventArgs e)
    {
        analiseDocumental = e.Value?.ToString() ?? "";
        if (analiseDocumental == "eliminado")
        {
            _ = FinalizarPorEliminacao();
        }
    }

    private async Task FinalizarPorEliminacao()
    {
        salvando = true;
        erro = "";
        try
        {
            var baseUrl = "http://localhost:5002";
            var request = new HttpRequestMessage(HttpMethod.Post, $"{baseUrl}/api/avaliador-painel/baremas/{baremaId}/finalizar-eliminacao");
            request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", _token);
            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                sucesso = true;
            }
            else
            {
                var msg = await response.Content.ReadAsStringAsync();
                erro = $"Erro ao finalizar: {msg}";
            }
        }
        catch (Exception ex)
        {
            erro = $"Erro ao finalizar: {ex.Message}";
        }
        finally
        {
            salvando = false;
        }
    }

    private void CalcularTotais()
    {
        soma1 = p1_1 + p1_2 + p1_3 + p1_4 + p1_5 + p1_6;
        soma2 = p2_1 + p2_2 + p2_3 + p2_4 + p2_5;
        soma3 = p3_1 + p3_2 + p3_3 + p3_4;
        totalGeral = soma1 + soma2 + soma3;
    }

    private void OnTemplateItemChange(long itemId, ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var valor))
        {
            avaliacoesTemplate[itemId] = valor;
        }
        CalcularSecoesTemplate();
    }

    private void CalcularSecoesTemplate()
    {
        somasSecao.Clear();
        if (templateAtivo == null) return;
        foreach (var item in templateAtivo.Itens)
        {
            if (!somasSecao.ContainsKey(item.SecaoOrdem))
                somasSecao[item.SecaoOrdem] = 0;
            somasSecao[item.SecaoOrdem] += avaliacoesTemplate.GetValueOrDefault(item.Id);
        }
    }

    private double CalcularNotaFinalTemplate()
    {
        if (templateAtivo == null || !templateAtivo.Itens.Any()) return 0;
        var total = avaliacoesTemplate.Values.Sum();
        var count = templateAtivo.Itens.Count;
        return count > 0 ? total / count : 0;
    }

    private async Task VisualizarPdf(long documentoId)
    {
        var baseUrl = "http://localhost:5002";
        var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "avaliador_token");

        var request = new HttpRequestMessage(HttpMethod.Get, $"{baseUrl}/api/avaliador-painel/documentos/{documentoId}/download");
        request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

        var response = await Http.SendAsync(request);
        if (response.IsSuccessStatusCode)
        {
            var bytes = await response.Content.ReadAsByteArrayAsync();
            var base64 = Convert.ToBase64String(bytes);
            pdfUrl = $"data:application/pdf;base64,{base64}";
            pdfVisualizando = true;
        }
    }

