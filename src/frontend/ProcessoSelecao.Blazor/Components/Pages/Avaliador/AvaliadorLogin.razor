@page "/avaliador/login"
@layout Layouts.AvaliadorLayout
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@using ProcessoSelecao.Blazor.Models

<PageTitle>Login - Avaliador</PageTitle>

<div class="flex items-center justify-center min-h-[80vh]">
    <div class="bg-white rounded-lg shadow-md p-8 w-full max-w-md">
        <div class="text-center mb-6">
            <span class="material-icons text-5xl text-indigo-600">rate_review</span>
            <h1 class="text-2xl font-bold text-gray-800 mt-2">Área do Avaliador</h1>
            <p class="text-sm text-gray-500">Acesse para avaliar os candidatos</p>
        </div>

        @if (!string.IsNullOrEmpty(erro))
        {
            <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded mb-4 text-sm">@erro</div>
        }

        <form @onsubmit="Login" class="space-y-4">
            <div>
                <label class="block text-sm font-medium mb-1">CPF</label>
                <input type="text" class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200" @bind:get="cpf" @bind:set="OnCpfSet" @bind:event="oninput" placeholder="000.000.000-00" maxlength="14" required />
                @if (statusCpf == "valido")
                {
                    <div class="text-green-600 text-xs mt-1">CPF válido</div>
                }
                @if (statusCpf == "invalido")
                {
                    <div class="text-red-600 text-xs mt-1">CPF inválido</div>
                }
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">Senha</label>
                <input type="password" class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200" @bind="senha" required />
            </div>
            <button type="submit" class="w-full bg-indigo-600 text-white px-4 py-2 rounded hover:bg-indigo-700 transition-colors font-medium" disabled="@carregando">
                @if (carregando) { <span>Entrando...</span> } else { <span>Entrar</span> }
            </button>
        </form>
    </div>
</div>

@code {
    private string cpf = "";
    private string senha = "";
    private string erro = "";
    private string statusCpf = "";
    private bool carregando = false;

    private void OnCpfSet(string? value)
    {
        cpf = CpfValidator.FormatProgressive(value);
        var digits = CpfValidator.Clean(cpf);
        statusCpf = digits.Length == 11 ? (CpfValidator.IsValid(digits) ? "valido" : "invalido") : "";
    }

    private async Task Login()
    {
        carregando = true;
        erro = "";
        statusCpf = "";
        StateHasChanged();

        var cpfDigitos = CpfValidator.Clean(cpf);
        if (cpfDigitos.Length != 11 || !CpfValidator.IsValid(cpfDigitos))
        {
            statusCpf = "invalido";
            carregando = false;
            return;
        }

        try
        {
            var baseUrl = "http://localhost:5002";
            var response = await Http.PostAsJsonAsync($"{baseUrl}/api/avaliador-auth/login", new { Cpf = cpf, Senha = senha });

            if (!response.IsSuccessStatusCode)
            {
                erro = "CPF ou senha inválidos.";
                carregando = false;
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<AvaliadorAuthResponse>();
            if (result != null)
            {
                await JS.InvokeVoidAsync("sessionStorage.setItem", "avaliador_token", result.Token);
                await JS.InvokeVoidAsync("sessionStorage.setItem", "avaliador_id", result.AvaliadorId.ToString());
                await JS.InvokeVoidAsync("sessionStorage.setItem", "avaliador_nome", result.Nome);
                Nav.NavigateTo("/avaliador/painel");
            }
        }
        catch (Exception ex)
        {
            erro = $"Erro ao conectar: {ex.Message}";
        }
        finally
        {
            carregando = false;
        }
    }
}
