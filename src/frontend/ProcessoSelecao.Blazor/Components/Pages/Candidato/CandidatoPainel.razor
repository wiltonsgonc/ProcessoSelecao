@page "/candidato/painel"
@layout Layouts.CandidatoLayout
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IConfiguration Configuration
@inject IWebHostEnvironment Environment
@using ProcessoSelecao.Blazor.Models

<PageTitle>Painel - Candidato</PageTitle>

@if (carregando)
{
    <div class="text-center py-10">
        <span class="material-icons text-5xl text-gray-400 animate-spin">refresh</span>
        <p class="text-gray-500 mt-2">Carregando...</p>
    </div>
}
else if (candidato == null)
{
    <div class="text-center py-10">
        <span class="material-icons text-5xl text-gray-400">error_outline</span>
        <p class="text-gray-500 mt-2">Dados não encontrados.</p>
    </div>
}
else
{
    <div class="mb-6">
        <h2 class="text-xl font-bold text-gray-800">Minha Inscrição</h2>
        <p class="text-sm text-gray-500">Número: <span class="font-mono font-semibold">@candidato.NumeroInscricao</span></p>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
        <!-- Dados Pessoais -->
        <div class="bg-white border border-gray-200 rounded-lg p-5">
            <div class="flex items-center gap-2 mb-4">
                <span class="material-icons text-indigo-600">person</span>
                <h3 class="font-semibold text-gray-800">Dados Pessoais</h3>
            </div>
            <dl class="space-y-2 text-sm">
                <div class="flex justify-between">
                    <dt class="text-gray-500">Nome:</dt>
                    <dd class="font-medium text-gray-800">@candidato.Nome</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-gray-500">CPF:</dt>
                    <dd class="font-medium text-gray-800">@candidato.Cpf</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-gray-500">E-mail:</dt>
                    <dd class="font-medium text-gray-800">@candidato.Email</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-gray-500">Telefone:</dt>
                    <dd class="font-medium text-gray-800">@(candidato.Telefone ?? "—")</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-gray-500">Área de Pesquisa:</dt>
                    <dd class="font-medium text-gray-800">@(candidato.AreaPesquisa ?? "—")</dd>
                </div>
            </dl>
        </div>

        <!-- Status da Inscrição -->
        <div class="bg-white border border-gray-200 rounded-lg p-5">
            <div class="flex items-center gap-2 mb-4">
                <span class="material-icons text-indigo-600">info</span>
                <h3 class="font-semibold text-gray-800">Status</h3>
            </div>
            <dl class="space-y-2 text-sm">
                <div class="flex justify-between">
                    <dt class="text-gray-500">Processo:</dt>
                    <dd class="font-medium text-gray-800">@candidato.ProcessoSelecaoId</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-gray-500">Status Validação:</dt>
                    <dd>
                        <span class="inline-block px-2 py-0.5 rounded text-xs font-semibold text-white @GetStatusClass(candidato.StatusValidacao)">
                            @GetStatusLabel(candidato.StatusValidacao)
                        </span>
                    </dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-gray-500">Data Cadastro:</dt>
                    <dd class="font-medium text-gray-800">@candidato.DataCadastro.ToString("dd/MM/yyyy")</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-gray-500">Pontuação Média:</dt>
                    <dd class="font-semibold text-indigo-600">@candidato.PontuacaoMedia.ToString("F2")</dd>
                </div>
            </dl>
        </div>

        <!-- Documentos -->
        <div class="bg-white border border-gray-200 rounded-lg p-5 md:col-span-2">
            <div class="flex items-center gap-2 mb-4">
                <span class="material-icons text-indigo-600">description</span>
                <h3 class="font-semibold text-gray-800">Documentos</h3>
            </div>
            <div class="grid grid-cols-2 gap-4 text-sm">
                <div class="flex justify-between">
                    <span class="text-gray-500">Total de documentos:</span>
                    <span class="font-medium text-gray-800">@candidato.TotalDocumentos</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-gray-500">Documentos validados:</span>
                    <span class="font-medium text-green-600">@candidato.DocumentosValidados</span>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private Candidato? candidato;
    private bool carregando = true;
    private string baseUrl = "";

    protected override async Task OnInitializedAsync()
    {
        baseUrl = Configuration["Backend:BaseUrl"] ?? "http://localhost:5002/api";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        string token;
        string candidatoIdStr;
        if (Environment.IsDevelopment())
        {
            token = "dev-bypass-token";
            candidatoIdStr = "1";
        }
        else
        {
            token = await JS.InvokeAsync<string>("sessionStorage.getItem", "candidato_token");
            if (string.IsNullOrEmpty(token))
            {
                Nav.NavigateTo("/candidato/login");
                return;
            }

            candidatoIdStr = await JS.InvokeAsync<string>("sessionStorage.getItem", "candidato_id");
            if (string.IsNullOrEmpty(candidatoIdStr) || !long.TryParse(candidatoIdStr, out _))
            {
                Nav.NavigateTo("/candidato/login");
                return;
            }
        }

        if (!long.TryParse(candidatoIdStr, out var candidatoId)) candidatoId = 1;

        try
        {
            var request = new HttpRequestMessage(HttpMethod.Get, $"{baseUrl}/candidatos/{candidatoId}");
            request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                candidato = await response.Content.ReadFromJsonAsync<Candidato>(
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            }
            else
            {
                Nav.NavigateTo("/candidato/login");
            }
        }
        catch
        {
            Nav.NavigateTo("/candidato/login");
        }
        finally
        {
            carregando = false;
        }

        StateHasChanged();
    }

    private string GetStatusLabel(StatusValidacao s) => s switch
    {
        StatusValidacao.Pendente => "Pendente",
        StatusValidacao.EmAnalise => "Em Análise",
        StatusValidacao.Validado => "Validado",
        StatusValidacao.Rejeitado => "Rejeitado",
        _ => "Desconhecido"
    };

    private string GetStatusClass(StatusValidacao s) => s switch
    {
        StatusValidacao.Pendente => "bg-yellow-500",
        StatusValidacao.EmAnalise => "bg-cyan-600",
        StatusValidacao.Validado => "bg-green-600",
        StatusValidacao.Rejeitado => "bg-red-600",
        _ => "bg-gray-500"
    };
}
