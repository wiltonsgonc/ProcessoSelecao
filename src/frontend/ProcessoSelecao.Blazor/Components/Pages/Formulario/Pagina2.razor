@inject FormularioService FormularioService

<form @onsubmit="OnSubmit">
    <h2>Dados Básicos</h2>
    <div class="campo-obrigatorio">
        <label for="nome">Nome: <span class="asterisco">*</span></label>
        <input id="nome" @bind="dados.Nome" placeholder="Nome"
               class="@(string.IsNullOrEmpty(dados.Nome) && submitted ? "invalid" : "")" />
        @if (string.IsNullOrEmpty(dados.Nome) && submitted)
        {
            <div class="erro"><span>Campo obrigatório</span></div>
        }
    </div>

    <div class="campo-obrigatorio">
        <label for="dataNascimento">Data de Nascimento: <span class="asterisco">*</span></label>
        <input id="dataNascimento" type="date" placeholder="Data de Nascimento"
               value="@(string.IsNullOrEmpty(dados.DataNascimento) ? "" : DateTime.Parse(dados.DataNascimento).ToString("yyyy-MM-dd"))"
               @onchange="e => dados.DataNascimento = e.Value?.ToString()"
               class="@(string.IsNullOrEmpty(dados.DataNascimento) && submitted ? "invalid" : "")" />
        @if (string.IsNullOrEmpty(dados.DataNascimento) && submitted)
        {
            <div class="erro"><span>Campo obrigatório</span></div>
        }
    </div>

    <div>
        <label for="paisNatal">País Natal:</label>
        <input id="paisNatal" @bind="dados.PaisNatal" placeholder="País Natal" />
    </div>

    <div>
        <label for="estadoNatal">Estado Natal:</label>
        <input id="estadoNatal" @bind="dados.EstadoNatal" placeholder="Estado Natal" />
    </div>

    <div>
        <label for="naturalidade">Naturalidade:</label>
        <input id="naturalidade" @bind="dados.Naturalidade" placeholder="Naturalidade" />
    </div>

    <div>
        <label for="nomeSocial">Nome Social:</label>
        <input id="nomeSocial" @bind="dados.NomeSocial" placeholder="Nome Social" />
    </div>

    <div>
        <label for="estadoCivil">Estado Civil:</label>
        <input id="estadoCivil" @bind="dados.EstadoCivil" placeholder="Estado Civil" />
    </div>

    <div>
        <label for="nacionalidade">Nacionalidade:</label>
        <input id="nacionalidade" @bind="dados.Nacionalidade" placeholder="Nacionalidade" />
    </div>

    <div class="campo-obrigatorio">
        <label for="email">E-mail: <span class="asterisco">*</span></label>
        <input id="email" @bind="dados.Email" type="email" placeholder="E-mail"
               class="@(string.IsNullOrEmpty(dados.Email) && submitted ? "invalid" : "")" />
        @if (string.IsNullOrEmpty(dados.Email) && submitted)
        {
            <div class="erro"><span>Campo obrigatório</span></div>
        }
    </div>

    <div class="campo-obrigatorio">
        <label for="sexo">Sexo: <span class="asterisco">*</span></label>
        <input id="sexo" @bind="dados.Sexo" placeholder="Sexo"
               class="@(string.IsNullOrEmpty(dados.Sexo) && submitted ? "invalid" : "")" />
        @if (string.IsNullOrEmpty(dados.Sexo) && submitted)
        {
            <div class="erro"><span>Campo obrigatório</span></div>
        }
    </div>

    <h2>Documentos</h2>
    <div class="campo-cpf">
        <label for="cpf">CPF:</label>
        <input id="cpf" value="@dados.Cpf" @oninput="OnCpfInput" @onblur="OnCpfBlur" placeholder="000.000.000-00" maxlength="14" />
        @if (statusCpf == "valido")
        {
            <div class="acao valido"><span>CPF válido</span></div>
        }
        @if (statusCpf == "invalido")
        {
            <div class="acao invalido"><span>CPF inválido</span></div>
        }
    </div>

    <h2>Endereço</h2>
    <div class="campo-obrigatorio">
        <label for="telefone1">Telefone I: <span class="asterisco">*</span></label>
        <input id="telefone1" @bind="dados.Telefone1" placeholder="Telefone I"
               class="@(string.IsNullOrEmpty(dados.Telefone1) && submitted ? "invalid" : "")" />
        @if (string.IsNullOrEmpty(dados.Telefone1) && submitted)
        {
            <div class="erro"><span>Campo obrigatório</span></div>
        }
    </div>

    <div>
        <label for="telefone2">Telefone II:</label>
        <input id="telefone2" @bind="dados.Telefone2" placeholder="Telefone II" />
    </div>

    <h2>Informações Adicionais</h2>
    <div>
        <label for="corRaca">Cor/Raça:</label>
        <input id="corRaca" @bind="dados.CorRaca" placeholder="Cor/Raça" />
    </div>

    <div class="campo-obrigatorio">
        <label for="autorizacaoDados">Autorizo a utilização de dados pessoais: <span class="asterisco">*</span></label>
        <select id="autorizacaoDados" @bind="dados.AutorizacaoDados"
                class="@(string.IsNullOrEmpty(dados.AutorizacaoDados) && submitted ? "invalid" : "")">
            <option value="">Selecione</option>
            <option value="sim">Sim</option>
            <option value="nao">Não</option>
        </select>
        @if (string.IsNullOrEmpty(dados.AutorizacaoDados) && submitted)
        {
            <div class="erro"><span>Campo obrigatório</span></div>
        }
    </div>

    <h2>Dados Gerais de Estrangeiros</h2>
    <div>
        <label for="tipoVisto">Tipo de Visto:</label>
        <input id="tipoVisto" @bind="dados.TipoVisto" placeholder="Tipo de Visto" />
    </div>

    <div class="botoes">
        <button type="button" @onclick="OnAnteriorHandler">Anterior</button>
        <button type="submit">Próximo</button>
    </div>
</form>

@code {
    [Parameter] public EventCallback OnProxima { get; set; }
    [Parameter] public EventCallback OnAnterior { get; set; }

    private DadosPagina2 dados = new();
    private bool submitted = false;
    private string statusCpf = "";

    protected override void OnInitialized()
    {
        if (FormularioService.DadosPagina2 != null)
        {
            dados = FormularioService.DadosPagina2;
        }
        else if (FormularioService.DadosPagina1 != null)
        {
            var d1 = FormularioService.DadosPagina1;
            dados.Nome = d1.Nome ?? "";
            dados.DataNascimento = d1.DataNascimento ?? "";
            dados.Email = d1.Email ?? "";
            dados.Telefone1 = d1.Telefone ?? "";
            if (string.Equals(d1.TipoDocumento, "CPF", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrEmpty(d1.NumeroDocumento))
            {
                dados.Cpf = d1.NumeroDocumento;
            }
        }
    }

    private void OnCpfInput(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        dados.Cpf = CpfValidator.FormatProgressive(value);
        var digits = CpfValidator.Clean(dados.Cpf);
        if (digits.Length == 11)
        {
            statusCpf = CpfValidator.IsValid(digits) ? "valido" : "invalido";
        }
        else
        {
            statusCpf = "";
        }
    }

    private void OnCpfBlur()
    {
        var digits = CpfValidator.Clean(dados.Cpf);
        if (digits.Length == 11)
        {
            statusCpf = CpfValidator.IsValid(digits) ? "valido" : "invalido";
        }
        else if (digits.Length > 0)
        {
            statusCpf = "invalido";
        }
        else
        {
            statusCpf = "";
        }
    }

    private async Task OnSubmit()
    {
        submitted = true;
        statusCpf = "";

        if (!string.IsNullOrEmpty(dados.Cpf))
        {
            var cpfDigitos = CpfValidator.Clean(dados.Cpf);
            if (cpfDigitos.Length != 11 || !CpfValidator.IsValid(cpfDigitos))
            {
                statusCpf = "invalido";
                return;
            }
        }

        if (string.IsNullOrEmpty(dados.Nome) || string.IsNullOrEmpty(dados.DataNascimento) ||
            string.IsNullOrEmpty(dados.Email) || string.IsNullOrEmpty(dados.Sexo) ||
            string.IsNullOrEmpty(dados.Telefone1) || string.IsNullOrEmpty(dados.AutorizacaoDados))
            return;

        FormularioService.SalvarPagina2(dados);
        await OnProxima.InvokeAsync();
    }

    private async Task OnAnteriorHandler() => await OnAnterior.InvokeAsync();
}
