@page "/"
@layout Layouts.PublicLayout

<div class="max-w-6xl mx-auto px-5">
    <div class="text-center py-10 px-5 bg-gradient-to-br from-indigo-500 to-purple-600 text-white rounded-xl mb-10">
        <h1 class="text-4xl font-bold mb-2">Processo Seletivo</h1>
        <p class="text-xl opacity-90">Participe dos processos seletivos abertos e acompanhe sua inscrição</p>
    </div>

    <ProcessoSelecao.Blazor.Components.Pages.Public.ProcessoPublicList />

    <div class="text-center py-10 px-5 bg-gray-50 rounded-xl mt-10">
        <h2 class="text-2xl font-bold mb-8">Como funciona?</h2>
        <div class="flex justify-around flex-wrap gap-5">
            <div class="flex-1 min-w-[200px] max-w-[300px]">
                <div class="w-12 h-12 bg-indigo-500 text-white rounded-full flex items-center justify-center text-xl font-bold mx-auto mb-4">1</div>
                <h3 class="font-semibold mb-1">Inscreva-se</h3>
                <p class="text-gray-500">Preencha o formulário com seus dados</p>
            </div>
            <div class="flex-1 min-w-[200px] max-w-[300px]">
                <div class="w-12 h-12 bg-indigo-500 text-white rounded-full flex items-center justify-center text-xl font-bold mx-auto mb-4">2</div>
                <h3 class="font-semibold mb-1">Envie Documentos</h3>
                <p class="text-gray-500">Anexe os documentos necessários</p>
            </div>
            <div class="flex-1 min-w-[200px] max-w-[300px]">
                <div class="w-12 h-12 bg-indigo-500 text-white rounded-full flex items-center justify-center text-xl font-bold mx-auto mb-4">3</div>
                <h3 class="font-semibold mb-1">Acompanhe</h3>
                <p class="text-gray-500">Verifique o status da sua inscrição</p>
            </div>
        </div>
    </div>
</div>
