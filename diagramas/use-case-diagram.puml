@startuml ProcessoSelecao
left to right direction

actor "Candidato" as Candidato
actor "Avaliador" as Avaliador
actor "Administrador" as Admin

rectangle "Sistema de Seleção IC/Pesquisa" {
  ' --- Candidato ---
  (Realizar inscrição pública) as UC1
  (Enviar documentos na inscrição) as UC2
  (Acompanhar inscrição) as UC3
  (Editar dados do cadastro) as UC4

  ' --- Avaliador ---
  (Fazer login com CPF e senha) as UC6
  (Visualizar candidatos atribuídos) as UC7
  (Visualizar documentos do candidato) as UC8
  (Preencher avaliação) as UC9
  (Finalizar avaliação) as UC10

  ' --- Administrador ---
  (Gerenciar processos de seleção) as UC11
  (Gerenciar candidatos) as UC12
  (Gerenciar avaliadores) as UC13
  (Gerenciar baremas) as UC14
  (Validar documentos) as UC15
  (Visualizar avaliações consolidadas) as UC16
  (Habilitar edição de documentos) as UC17

  ' --- Sistema ---
  (Calcular nota final) as UC18
  (Notificar por e-mail) as UC19
  (Prevenir auto-avaliação) as UC20
}

' Relações com atores
Candidato --> UC1
Candidato --> UC2
Candidato --> UC3
Candidato --> UC4
Candidato --> UC5

Avaliador --> UC6
Avaliador --> UC7
Avaliador --> UC8
Avaliador --> UC9
Avaliador --> UC10

Admin --> UC11
Admin --> UC12
Admin --> UC13
Admin --> UC14
Admin --> UC15
Admin --> UC16
Admin --> UC17

' Inclusões e extensões
UC1 .> UC2 : <<include>>
UC3 .> UC4 : <<include>>
UC4 .> UC5 : <<include>>
UC15 .> UC2 : <<include>>
UC9 .> UC18 : <<include>>
UC10 .> UC18 : <<include>>
UC13 .> UC6 : <<include>>
UC20 ..> UC9 : protege
UC16 .> UC18 : <<include>>
UC17 .> UC5 : habilita

note right of Avaliador
  <b>Auto-avaliação bloqueada:</b>
  avaliador não pode avaliar
  candidato com o mesmo CPF
end note

@enduml
