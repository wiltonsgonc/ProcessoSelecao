@startuml ProcessoSelecao

' ============================================================
' Ciclo de vida de um Candidato no processo
' ============================================================

[*] --> Inscrito : Candidato submete inscrição\n(Pagina1-4)

state Inscrito {
  [*] --> PendenteDoc : Documentos enviados
  PendenteDoc --> EmAnaliseDoc : Admin inicia análise
  EmAnaliseDoc --> DocumentosValidados : Todos documentos aprovados
  EmAnaliseDoc --> DocumentosRejeitado : 1+ documentos rejeitados
  DocumentosRejeitado --> [*] : Notificação de rejeição
}

DocumentosValidados --> EmAvaliacao : Baremas criados para avaliadores
DocumentosRejeitado --> [*] : Processo encerrado para candidato

state EmAvaliacao {
  [*] --> AguardandoAvaliadores
  AguardandoAvaliadores --> SendoAvaliado : 1+ avaliadores aceitam
  SendoAvaliado --> AvaliadoParcial : 1 barema concluído
  AvaliadoParcial --> TotalmenteAvaliado : Todos baremas concluídos
  TotalmenteAvaliado --> [*]
}

TotalmenteAvaliado --> Classificado : Notas consolidadas\n(pelo admin)

state Classificado {
  [*] --> Aprovado : Nota ≥ corte
  [*] --> EmListaEspera : Nota próxima ao corte
  [*] --> Reprovado : Nota < corte
}

Aprovado --> [*] : Carta de oferta enviada
EmListaEspera --> [*] : Aguarda desistência
Reprovado --> [*] : Notificação enviada

' ============================================================
' Máquina de estados do Barema
' ============================================================

state "StatusBarema" as SB {
  [*] --> BaremaPendente : Barema criado
  BaremaPendente --> BaremaEmPreenchimento : Avaliador inicia preenchimento
  BaremaEmPreenchimento --> BaremaConcluido : Avaliador finaliza
  BaremaEmPreenchimento --> BaremaCancelado : Admin cancela
  BaremaConcluido --> [*]
  BaremaCancelado --> [*]
}

' ============================================================
' Máquina de estados do Processo de Seleção
' ============================================================

state "StatusProcesso" as SP {
  [*] --> Rascunho : Processo criado
  Rascunho --> Aberto : Data de início chegou\n(ou admin inicia)
  Aberto --> EmAndamento : Inscrições encerradas
  EmAndamento --> Finalizado : Prazo expirou\n(ou admin finaliza)
  Finalizado --> [*]
  Rascunho --> Cancelado : Admin cancela
  Aberto --> Cancelado : Admin cancela
  EmAndamento --> Cancelado : Admin cancela
}

@enduml
