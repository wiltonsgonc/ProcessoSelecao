@startuml ProcessoSelecao
package "Sistema de Seleção IC/Pesquisa" {

  [Frontend Blazor Server] as Frontend
  [API .NET 10] as Api

  component "Módulo Inscrição" as ModInsc {
    [InscricaoService]
  }

  component "Módulo Cadastro" as ModCad {
    [CandidatoService]
    [DocumentoService]
  }

  component "Módulo Avaliação" as ModAv {
    [AvaliadorService]
    [AvaliadorAuthService]
    [BaremaService]
  }

  component "Módulo Processo" as ModProc {
    [ProcessoSelecaoService]
  }

  component "Módulo Notificação" as ModNot {
    [EmailNotificationService]
  }

  database "SQL Server 2022" as DB {
    [Tabela ProcessosSelecao]
    [Tabela Candidatos]
    [Tabela Documentos]
    [Tabela Avaliadores]
    [Tabela Baremas]
  }

  node "Armazenamento Local" as Storage {
    [Documentos PDF]
  }

  ' Conexões
  Frontend --> Api : REST + JWT
  Api --> ModInsc : /api/formulario
  Api --> ModCad : /api/candidatos, /api/documentos
  Api --> ModAv : /api/avaliadores, /api/avaliador-auth, /api/baremas
  Api --> ModProc : /api/processosselecao

  ModInsc --> DB : EF Core
  ModCad --> DB : EF Core
  ModAv --> DB : EF Core
  ModProc --> DB : EF Core

  ModCad --> Storage : Upload/Download
  ModInsc --> Storage : Upload documentos

  ModAv --> ModNot : Notifica avaliadores
  ModProc --> ModNot : Notifica prazos
  ModNot --> ModCad : Busca dados do candidato

  note right of Storage
    <b>Armazenamento local</b>
    Diretorio /documentos/
    por candidatoId
  end note
}

@enduml
