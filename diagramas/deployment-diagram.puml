@startuml ProcessoSelecao
node "Frontend Blazor Server" as Frontend {
  node "ProcessoSelecao.Blazor" as FE
  note right of FE
    <b>Blazor Web App (Server-Side)</b>
    Tailwind CSS via CDN
    Porta 5119 (local) / 4200 (container)
  end note
}

node "Backend .NET 10 Web API" as Backend {
  node "ProcessoSelecao.Api" as API
  note right of API
    <b>ASP.NET Core Web API</b>
    EF Core + JWT + BCrypt
    Porta 5002 (local e container)
  end note
}

database "SQL Server 2022" as DB {
  node "ProcessoSelecaoDb" as SqlDb
  note right of SqlDb
    <b>Porta externa:</b> 14330 -> 1433
    Volume nomeado: mssql_data
    Usuario app: db_user (DBeaver/SSMS)
  end note
}

node "Armazenamento Local" as Storage {
  [Documentos PDF por candidato]
  note right of Storage
    Diretorio /documentos/
    Pasta por candidatoId
    Sem nuvem
  end note
}

actor "Usuário" as C
actor "Avaliador" as Aval
actor "Administrador" as Admin

' Acesso web
C -> Frontend : HTTP/HTTPS
Aval -> Frontend : HTTP/HTTPS
Admin -> Frontend : HTTP/HTTPS

' Comunicação interna
Frontend --> Backend : REST (localhost:5002) / JWT
Backend --> DB : EF Core / SqlClient
Backend --> Storage : Upload/Download local
Backend --> DB : Migrate() na inicializacao

note right of C
  Inscricao publica (4 paginas)
  Acompanhamento (num. inscricao + CPF)
end note

note right of Aval
  Login CPF + senha (JWT)
  Painel e formulario de avaliacao
end note

note right of Admin
  CRUD processos/candidatos/
  avaliadores/baremas/documentos
  Validacao de documentos
end note

@enduml
