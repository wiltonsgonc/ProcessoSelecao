# ==============================================
# Template de Variaveis de Ambiente
# Copie para .env.dev (desenvolvimento) ou .env.prod (producao)
# e preencha os valores.
#
# cp .env.example .env.dev
# cp .env.example .env.prod
# ==============================================

# SQL Server
ACCEPT_EULA=Y
SA_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MSSQL_PID=Developer
MSSQL_MEMORY_LIMIT_MB=2048

# Database
DB_HOST=sqlserver
DB_NAME=ProcessoSelecaoDb
DB_USER=sa
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_EXTERNAL_USER=db_user
DB_EXTERNAL_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# JWT (minimo 32 caracteres)
JWT_SECRETKEY=CHANGE_ME_MINIMUM_32_CHARACTERS_HERE
JWT_ISSUER=ProcessoSelecaoApi
JWT_AUDIENCE=ProcessoSelecaoWeb

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@processoselecao.com

# App
ASPNETCORE_ENVIRONMENT=Development
