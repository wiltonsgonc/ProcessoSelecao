# ==============================================
# PRODUCAO - Variaveis de ambiente
# Copie este arquivo para .env.prod e preencha os valores
# cp .env.example .env.prod
# ATENCAO: Use senhas FORTES e DIFERENTES do desenvolvimento
# ==============================================

# SQL Server
ACCEPT_EULA=Y
# ATENCAO: Substitua por senhas FORTES reais antes de usar em producao!
# Politica SQL Server: 8+ chars, maiuscula, minuscula, numero, simbolo
SA_PASSWORD=CHANGE_ME_STRONG_PRODUCTION_PASSWORD
MSSQL_PID=Developer
MSSQL_MEMORY_LIMIT_MB=2048

# Database
DB_HOST=sqlserver
DB_NAME=ProcessoSelecaoDb
DB_USER=sa
DB_PASSWORD=CHANGE_ME_STRONG_PRODUCTION_PASSWORD
DB_EXTERNAL_USER=db_user
DB_EXTERNAL_PASSWORD=CHANGE_ME_STRONG_PRODUCTION_PASSWORD

# JWT (minimo 32 caracteres - NUNCA reutilizar chaves de dev)
JWT_SECRETKEY=CHANGE_ME_MINIMUM_32_CHARACTERS_PRODUCTION
JWT_ISSUER=ProcessoSelecaoApi
JWT_AUDIENCE=ProcessoSelecaoWeb

# Email (producao: configurar com servico real)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@processoselecao.com

# App
ASPNETCORE_ENVIRONMENT=Production
